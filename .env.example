# AutoPass Switzerland – Umgebungsvariablen
# Kopieren nach .env (wird nicht eingecheckt).

# PostgreSQL
DATABASE_URL="postgresql://autopass:autopass@localhost:5432/autopass?schema=public"

# Betriebsart: development | demo | production. Mit production ist DEMO_MODE verboten.
APP_ENV="development"

# Öffentliche Basis-URL (für Einladungslinks)
APP_BASE_URL="http://localhost:3000"

# Lokaler Speicher für Dokumente (MVP). Produktion: S3-kompatibler Adapter.
STORAGE_DIR="./storage"

# Signaturschlüssel für Partner-Webhooks (HMAC-SHA256). Im Demo-Betrieb nur Testwert.
INSURANCE_DEMO_WEBHOOK_SECRET="demo-only-change-me"

# Maximale Dokumentgrösse in Bytes (10 MiB)
MAX_UPLOAD_BYTES="10485760"

# Session-Lebensdauer in Stunden
SESSION_TTL_HOURS="12"

# Demo-Modus: Simulationsoberfläche für Versicherer und Behörden anzeigen.
# Muss in Produktion auf "false" stehen.
DEMO_MODE="true"
